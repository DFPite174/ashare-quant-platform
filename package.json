  "description": "Institutional-grade A-share Quantitative Research Platform with NautilusTrader, Tushare Lake, and QuantMind UI",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "backend:start": "python -m uvicorn backend.app:app --host 127.0.0.1 --port 8000 --reload",
