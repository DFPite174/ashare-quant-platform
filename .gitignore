# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# C extensions build artifacts (keep split_native.cp312-win_amd64.pyd if needed or gitignore dynamic builds)
# We keep existing verified upstream wheels and pyd in data/ or src/backtest/upstream if required.

# Distribution / packaging
build/
dist/
dist-react/
dist-electron/
*.egg-info/

# Unit test / coverage reports
.pytest_cache/
.coverage
htmlcov/

# Node & Frontend dependencies
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-react/
frontend/dist-electron/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment and sensitive keys
.env
.env.local
.env.*.local

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.bak
*.swp
